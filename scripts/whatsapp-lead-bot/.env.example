# Bot service HTTP port
PORT=8090

# Shared secret Chatwoot's AgentBot webhook must present. Chatwoot AgentBot
# webhooks are NOT HMAC-signed, so this is the only gate. Send it as
# `Authorization: Bearer <secret>` when configuring the AgentBot's webhook
# URL in Chatwoot, or append it to the URL path if the deployment can't set
# custom headers -- either way, generate a long random value and never
# reuse it across environments.
WEBHOOK_SHARED_SECRET=

# Central Chatwoot instance
CHATWOOT_BASE_URL=https://chatwoot.example.com
# Agent Bot API access token (per-bot, from Chatwoot's agent bot settings),
# used as the `api_access_token` header on every Chatwoot API call.
CHATWOOT_AGENT_BOT_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=
# Model for the visitor assistant. Every request asks OpenRouter for
# providers with `data_collection: deny` (PROVIDER_POLICY in src/assistant.js:
# visitors' messages carry names and phone numbers), and that policy excludes
# every free model -- their providers train on prompts -- so this must be a
# paid one. Same default as bl-site-package's content agent; a few cents per
# conversation, billed to this service's own OPENROUTER_API_KEY.
VISITOR_AGENT_MODEL=openai/gpt-oss-120b

# Escalate after this many bot turns in a single conversation, regardless
# of anything else. Every bot turn costs the customer real money (Meta
# per-message pricing) -- keep this low.
BOT_TURN_CAP=6

# How long a customer's /api/knowledge response is cached in-process before
# a fresh fetch. Site content changes rarely; keep this in the minutes
# range, not seconds, to avoid hammering every customer deployment.
KNOWLEDGE_CACHE_TTL_MS=300000

# Path to the per-customer registry file (account_id -> site + knowledge
# credentials). See src/registry.js for the exact shape.
REGISTRY_PATH=./registry.json
