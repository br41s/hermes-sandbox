#!/command/with-contenv sh
# shellcheck shell=sh
# BigLobster fork — per-boot config reconciliation.
#
# Additive s6 cont-init hook. Runs as root after 01-hermes-setup (the
# stage2 bootstrap) and before s6-rc starts the dashboard / gateway user
# services, so any config it writes is fresh by the time those processes
# read it. Lives in its own file (not inside upstream's stage2-hook.sh) so
# the fork's deploy logic survives upstream merges with zero conflicts —
# the only Dockerfile touch is the COPY that installs it.
#
# Replaces the env-patching block that used to live in the pre-s6
# docker/entrypoint.sh (now a deprecated upstream shim). On every boot:
#   1. Sync Zeabur-injected process env vars into $HERMES_HOME/.env and all
#      per-profile .env files (env_loader uses load_dotenv(override=True),
#      so .env must win; per-profile sync prevents stale revoked keys after
#      a secret rotation).
#   2. Re-assert the fork's runtime-critical config.yaml keys (idempotent)
#      so volumes seeded before a config change still get the intended
#      provider / model / memory settings. docker/config.yaml remains the
#      first-boot source of truth (seeded by stage2-hook.sh).
#   3. Seed memories/MEMORY.md on first boot from docker/MEMORY.md.
#   4. Wire GITHUB_TOKEN into git credential store (refreshed every boot).
#   5. Seed per-profile bootstrap files from docker/profiles/<name>/ (once).
#   6. Clone / pull per-profile repos declared in repos.txt → workspace/.
#   6b. Provision isolated BigLobster site checkouts (one per consuming cron
#      job) under checkouts/ so the SEO/GEO and Gap Hunter jobs no longer
#      share a working tree.
#   6e. Wire the auditor's GitHub PR trigger: enable the webhook platform on
#      the main profile and downgrade the auditor's own poll to a 6h safety
#      net (event-driven replaces most of the 10-min polling cost).
#   7. Log egress reachability for OpenRouter / HuggingFace.
#
# Never fatal: a non-zero exit from a cont-init script aborts container
# boot, so every step is guarded and the script always exits 0.

HERMES_HOME="${HERMES_HOME:-/opt/data}"
INSTALL_DIR="/opt/hermes"
PY="$INSTALL_DIR/.venv/bin/python"
export HERMES_HOME

# Harden every git operation below (sections 4 & 6) so a network or
# credential stall can never hang container boot. cont-init runs BEFORE
# s6 starts the dashboard/gateway services, so an unbounded git clone/pull
# here blocks the whole boot and takes the panel down with it.
#   - GIT_TERMINAL_PROMPT=0: never block on stdin asking for credentials;
#     a bad/expired token fails fast instead of hanging forever.
#   - GIT_HTTP_LOW_SPEED_*: abort a transfer that stalls below 1 KB/s for
#     30s (catches a half-open connection well before the hard timeout).
# The clone/pull calls in section 6 are additionally wrapped in `timeout`
# as a hard ceiling. All of this preserves the script's never-fatal
# contract: a timed-out git just prints a warning and boot continues.
export GIT_TERMINAL_PROMPT=0
export GIT_HTTP_LOW_SPEED_LIMIT=1000
export GIT_HTTP_LOW_SPEED_TIME=30

# Drop to hermes (matching stage2-hook.sh) so files land hermes-owned.
as_hermes() { [ "$(id -u)" = 0 ] || { "$@"; return; }; s6-setuidgid hermes "$@"; }

# --- GitHub token resolution (single source of truth: $HERMES_HOME/.env) ---
# GITHUB_TOKEN is NOT a platform-injected process env var in this deployment:
# Zeabur carries it neither in the container env nor in
# /run/s6/container_environment, so `with-contenv` hands this script an empty
# $GITHUB_TOKEN. The only durable copy lives in $HERMES_HOME/.env — historically
# as DUPLICATE, DIVERGENT lines (a stale classic `ghp_…` PAT alongside the valid
# fine-grained `github_pat_…` one). Without this block two things silently break
# every boot:
#   * section 1's env sync skips GITHUB_TOKEN (its os.environ lookup is empty),
#     so the divergent .env lines are never deduped and the gateway's own
#     load_dotenv (last-occurrence-wins) may load a revoked token.
#   * section 4 prints "GITHUB_TOKEN not set" and writes no git credential store,
#     so git/gh auth survives only on hand-placed on-disk files — fragile across
#     rotations and new profiles.
#
# Resolve the token the same way the gateway's load_dotenv does (last occurrence
# wins), preferring an explicit process-env value (authoritative when an operator
# sets GITHUB_TOKEN/GH_TOKEN on the platform) over the last matching line in the
# main .env. Export it and mirror GH_TOKEN so the section-1 python and the
# section-4 git config consume one consistent value, and so the gateway/delegate
# process env (which inherits this hook's downstream .env writes via load_dotenv)
# carries BOTH names.
if [ -z "${GITHUB_TOKEN:-}" ]; then
    GITHUB_TOKEN="${GH_TOKEN:-}"
fi
if [ -z "${GITHUB_TOKEN:-}" ] && [ -f "$HERMES_HOME/.env" ]; then
    GITHUB_TOKEN=$(grep -E '^GITHUB_TOKEN=' "$HERMES_HOME/.env" 2>/dev/null \
        | tail -n1 | cut -d= -f2- | tr -d '\r')
    [ -n "$GITHUB_TOKEN" ] || GITHUB_TOKEN=$(grep -E '^GH_TOKEN=' "$HERMES_HOME/.env" 2>/dev/null \
        | tail -n1 | cut -d= -f2- | tr -d '\r')
fi
if [ -n "${GITHUB_TOKEN:-}" ]; then
    GH_TOKEN="$GITHUB_TOKEN"
    export GITHUB_TOKEN GH_TOKEN
fi

# --- 0: restore missing SOUL.md files from bundled templates ---
# SOUL.md is both the agent's personality file AND the real-profile marker used
# by steps 1, 2, and 5 below. If an agent or user accidentally deletes it the
# profile becomes invisible to all downstream logic and the agent falls back to
# the default (BigLobster) context. Restoring it here, before any marker checks,
# breaks the circular dependency.
#
# Source: $INSTALL_DIR/docker/profiles/<name>/SOUL.md (baked into the image).
# Policy: ALWAYS restore when missing (not "seed once") — the image copy is the
# canonical version. This also means the panel can still edit SOUL.md freely;
# edits persist on the volume and are never overwritten while the file exists.
if [ -d "$INSTALL_DIR/docker/profiles" ]; then
    for src_soul in "$INSTALL_DIR/docker/profiles"/*/SOUL.md; do
        [ -f "$src_soul" ] || continue
        prof_name=$(basename "$(dirname "$src_soul")")
        dest_soul="$HERMES_HOME/profiles/$prof_name/SOUL.md"
        if [ ! -f "$dest_soul" ] && [ -d "$HERMES_HOME/profiles/$prof_name" ]; then
            as_hermes cp "$src_soul" "$dest_soul" \
                && echo "[03-biglobster] Restored missing SOUL.md for profile: $prof_name"
        fi
    done
fi

# --- 1 + 2: env sync + config key enforcement (run as hermes via the venv
# python, which has PyYAML; bare python3 may not). ---
as_hermes "$PY" - <<'PYEOF' || echo "[03-biglobster] Warning: config reconcile failed; continuing"
import os, re
from pathlib import Path

home = Path(os.environ.get("HERMES_HOME", "/opt/data"))

# 1. Sync Zeabur process env → .env (override wins via load_dotenv(override=True)).
#    The same keys are ALSO propagated into every profile's .env so a key
#    rotation (which only updates the process env / main .env) doesn't leave
#    per-profile gateways running on a stale, revoked key. This is the failure
#    mode that broke the grow-shop profile after the 2026-06-05 secret rotation:
#    the main .env got the new OPENROUTER_API_KEY but profiles/grow-shop/.env
#    kept the old (revoked) one → 401 "User not found" on every grow-shop turn.
#
#    POLICY: the main .env is the single source of truth for these keys and we
#    OVERWRITE the per-profile value. If you later want per-tenant billing with
#    a DISTINCT OPENROUTER_API_KEY per profile, drop that key from `inject`
#    (or special-case it) before deploying.
#    GH_TOKEN is synced alongside GITHUB_TOKEN (mirrored to the same value by
#    the token-resolution block above) so any consumer that reads only GH_TOKEN
#    — and the gateway/delegate process env via load_dotenv — gets it too.
inject = [
    "OPENROUTER_API_KEY", "HERMES_CALLBACK_SECRET", "HERMES_CALLBACK_URL",
    "HERMES_MAX_ITERATIONS", "EXA_API_KEY", "HUGGINGFACE_API_KEY",
    "GITHUB_TOKEN", "GH_TOKEN", "AUXILIARY_VISION_MODEL",
    # Read-only Google Search Console service-account key (base64), consumed by
    # the gsc MCP server (config.yaml mcp_servers.gsc). See optional-mcps/gsc/.
    "GSC_SERVICE_ACCOUNT_B64",
    # Stock B-roll for the `shorts` agent (plugins/shorts/stock.py). This is
    # BigLobster's OWN key, for BigLobster's own profiles running shorts against
    # biglobster.top. Rented tenants bring their own and are excluded from it
    # below, exactly like OPENROUTER_API_KEY — being in this list is only half
    # the contract, and the half that keeps our rotation working.
    "PEXELS_API_KEY",
]

def _sync_env_file(env_path, exclude=()):
    content = env_path.read_text(encoding="utf-8") if env_path.exists() else ""
    for var in inject:
        if var in exclude:
            continue
        val = os.environ.get(var, "")
        if not val:
            continue
        line_re = rf"^{re.escape(var)}=.*$"
        matches = re.findall(line_re, content, flags=re.MULTILINE)
        if len(matches) == 1:
            # Single line — replace in place, preserving file position.
            content = re.sub(line_re, lambda _m: f"{var}={val}", content, flags=re.MULTILINE)
        elif len(matches) > 1:
            # DUPLICATE / divergent lines (the GITHUB_TOKEN case: a stale
            # ghp_ PAT plus the valid github_pat_ one). load_dotenv keeps the
            # last occurrence, so leaving duplicates risks loading a revoked
            # token. Strip every occurrence and append exactly one canonical
            # line. Idempotent: on the next boot the single line is stripped
            # and re-appended unchanged.
            content = re.sub(rf"^{re.escape(var)}=.*(?:\n|$)", "", content, flags=re.MULTILINE)
            if content and not content.endswith("\n"):
                content += "\n"
            content += f"{var}={val}\n"
        else:
            sep = "" if (not content or content.endswith("\n")) else "\n"
            content += f"{sep}{var}={val}\n"
    env_path.write_text(content, encoding="utf-8")

# Main profile .env
_sync_env_file(home / ".env")
print(f"[03-biglobster] Synced env vars into {home / '.env'}")

# 1b. Auditor profile uses its OWN GitHub identity (hermes-auditor), never the
#     shared agent token — a reviewer must be a distinct identity from the
#     authors it reviews. Resolve HERMES_AUDITOR_GITHUB_TOKEN from os.environ
#     first, then the durable main .env (mirrors the GITHUB_TOKEN resolution
#     in the shell preamble), BEFORE the per-profile sync loop below so the
#     loop can exclude GITHUB_TOKEN/GH_TOKEN from the auditor's .env outright
#     instead of writing the shared token and hoping a later override catches
#     it. Invariant: the auditor profile holds ONLY the bot token, NEVER the
#     shared one — fail closed (no credential at all) if HERMES_AUDITOR_GITHUB_TOKEN
#     is unset, never fall back to the shared token. A silent fallback here
#     previously let the auditor authenticate `gh`/`git` AS the human account
#     that owns the shared token when the bot token was transiently missing at
#     boot (found 2026-07-15, biglobster PR #356's first review posted under
#     the CEO's own GitHub identity instead of hermes-auditor).
auditor_token = os.environ.get("HERMES_AUDITOR_GITHUB_TOKEN", "")
if not auditor_token and (home / ".env").exists():
    _m = re.search(r"^HERMES_AUDITOR_GITHUB_TOKEN=(.*)$",
                   (home / ".env").read_text(encoding="utf-8"), flags=re.MULTILINE)
    auditor_token = _m.group(1).strip() if _m else ""

# Dedicated OpenRouter key for the auditor, resolved the same way (env first,
# then the durable main .env). Lets the auditor's LLM spend bill to — and be
# capped by — a SEPARATE OpenRouter key from the shared content fleet, so
# content agents exhausting the shared key's weekly limit can no longer starve
# the auditor (the whole auditor cron failed HTTP 402 for >1 day on 2026-09-01
# once the shared key hit its cap). OPTIONAL: if unset, the auditor keeps the
# shared OPENROUTER_API_KEY the §1 loop already wrote — a missing LLM key kills
# reviews outright, so this falls back for availability rather than failing
# closed like the GitHub token above.
auditor_openrouter_key = os.environ.get("HERMES_AUDITOR_OPENROUTER_API_KEY", "")
if not auditor_openrouter_key and (home / ".env").exists():
    _m = re.search(r"^HERMES_AUDITOR_OPENROUTER_API_KEY=(.*)$",
                   (home / ".env").read_text(encoding="utf-8"), flags=re.MULTILINE)
    auditor_openrouter_key = _m.group(1).strip() if _m else ""

def _is_rented_tenant(env_path):
    """True for a bl-site-package rental — a profile that pays its own way.

    BL_SITE_URL is the marker rather than a slug prefix like "bl-": the slug is
    chosen by whoever runs provision_bl_client.py and a client named without
    that prefix would silently fall back to being billed to us. BL_SITE_URL is
    written by the provisioner for every rental and by nothing else.
    """
    if not env_path.exists():
        return False
    return bool(re.search(r"^BL_SITE_URL=", env_path.read_text(encoding="utf-8"),
                          flags=re.MULTILINE))


# Per-profile .env files — keeps tenant gateways on current keys after a
# rotation. SOUL.md is the "real profile" marker (same as the s6 reconciler).
profiles_root = home / "profiles"
if profiles_root.is_dir():
    for prof in sorted(p for p in profiles_root.iterdir() if p.is_dir()):
        if not (prof / "SOUL.md").exists():
            continue
        _prof_env = prof / ".env"
        # Never let the auditor profile's .env receive the shared token via
        # the generic path — §1b below is its ONLY source for these two keys.
        if prof.name == "auditor":
            _exclude = ("GITHUB_TOKEN", "GH_TOKEN")
            _why = ""
        elif _is_rented_tenant(_prof_env):
            # BYOK: a rented bl-site-package client brings their OWN OpenRouter
            # key and their model usage bills to them. Injecting ours here
            # silently defeated that — every boot overwrote the client key
            # written by provision_bl_client.py, so tenant agent runs billed to
            # BigLobster (found on bl-shoroban 2026-07-31). This is exactly the
            # "per-tenant billing with a DISTINCT OPENROUTER_API_KEY" case the
            # note above anticipated.
            #
            # PEXELS_API_KEY is the same contract for the `shorts` agent. Being
            # free does not make it shareable: Pexels issues one key per account
            # at 200 req/hour and 20k/month, so one key across the fleet caps
            # every client at once and lets a heavy tenant throttle the rest
            # into background-only videos. Each tenant brings their own, and
            # provision_bl_client.py refuses to sell the SKU without it.
            #
            # Trade-off, accepted deliberately: rental profiles no longer get
            # the rotation repair that §1's injection exists to provide (the
            # 2026-06-05 grow-shop incident). That repair is the wrong thing
            # for a key we do not own and must not rotate. A tenant whose own
            # key dies now fails visibly on their own jobs instead of silently
            # spending our credit.
            #
            # EXA_API_KEY / HUGGINGFACE_API_KEY are a DIFFERENT shape of leak
            # than OPENROUTER_API_KEY/PEXELS_API_KEY above: those two are BYOK
            # (the tenant supplies their own and we must not clobber it);
            # these two are ours alone and a tenant should never have EITHER —
            # no rented prompt uses HuggingFace at all, and web research for
            # tenants runs on the free ddgs backend (§2 below forces
            # web.search_backend: ddgs), never billed to BigLobster's Exa
            # account. Found while adding the shorts agent: gap-hunter and
            # product-articles (both daily SKUs) call web_search, so this was
            # a live, recurring leak, not a theoretical one (issue #174).
            _exclude = ("OPENROUTER_API_KEY", "PEXELS_API_KEY", "EXA_API_KEY", "HUGGINGFACE_API_KEY")
            _why = " (BYOK tenant — kept its own OPENROUTER_API_KEY/PEXELS_API_KEY; withheld shared EXA_API_KEY/HUGGINGFACE_API_KEY)"
        else:
            _exclude = ()
            _why = ""
        _sync_env_file(_prof_env, exclude=_exclude)
        if _is_rented_tenant(_prof_env):
            # _exclude only stops FUTURE overwrites — a profile that already
            # picked up EXA_API_KEY/HUGGINGFACE_API_KEY from a boot before
            # this fix shipped keeps that stale line forever otherwise (no
            # manifest of already-provisioned tenants exists to backfill by
            # hand; this loop already visits every one of them, every boot).
            _c = _prof_env.read_text(encoding="utf-8") if _prof_env.exists() else ""
            _stripped = _c
            for _v in ("EXA_API_KEY", "HUGGINGFACE_API_KEY"):
                _stripped = re.sub(rf"^{_v}=.*(?:\n|$)", "", _stripped, flags=re.MULTILINE)
            if _stripped != _c:
                _prof_env.write_text(_stripped, encoding="utf-8")
                print(f"[03-biglobster] Stripped stale shared research keys from {_prof_env}")
        print(f"[03-biglobster] Synced env vars into {_prof_env}{_why}")

_auditor_env = profiles_root / "auditor" / ".env"
if (profiles_root / "auditor" / "SOUL.md").exists():
    if auditor_token:
        _c = _auditor_env.read_text(encoding="utf-8") if _auditor_env.exists() else ""
        for _v in ("GITHUB_TOKEN", "GH_TOKEN"):
            _c = re.sub(rf"^{_v}=.*(?:\n|$)", "", _c, flags=re.MULTILINE)
        if _c and not _c.endswith("\n"):
            _c += "\n"
        _c += f"GITHUB_TOKEN={auditor_token}\nGH_TOKEN={auditor_token}\n"
        _auditor_env.write_text(_c, encoding="utf-8")
        print("[03-biglobster] Auditor profile pinned to hermes-auditor GitHub identity")
    else:
        # Fail closed: strip any stale GITHUB_TOKEN/GH_TOKEN lines (defense in
        # depth — the loop above already excluded them) so the auditor's gh/git
        # simply have no credential this boot, instead of silently keeping
        # whatever was written before. Loud, because a quiet no-op here is
        # exactly what let the fallback slip by unnoticed before.
        if _auditor_env.exists():
            _c = _auditor_env.read_text(encoding="utf-8")
            for _v in ("GITHUB_TOKEN", "GH_TOKEN"):
                _c = re.sub(rf"^{_v}=.*(?:\n|$)", "", _c, flags=re.MULTILINE)
            _auditor_env.write_text(_c, encoding="utf-8")
        print("[03-biglobster] WARNING: HERMES_AUDITOR_GITHUB_TOKEN not set — "
              "auditor profile has NO GitHub credential this boot (fail-closed, "
              "will never fall back to the shared token)")

# 1c. Auditor review-model knobs. Two env vars let the CEO swap the system- and
#     content-tier review models from Zeabur without a redeploy (auditor/llm.py
#     reads them at call time). Stamp whatever is set in the container env into
#     the auditor .env so the cron's agent subprocess inherits them; if unset,
#     auditor/llm.py falls back to its documented cheap defaults. Auditor-only —
#     deliberately NOT in the shared `inject` list (other profiles don't review).
if (profiles_root / "auditor" / "SOUL.md").exists():
    _ae = profiles_root / "auditor" / ".env"
    _c = _ae.read_text(encoding="utf-8") if _ae.exists() else ""
    for _mv in ("HERMES_AUDITOR_SYSTEM_MODEL", "HERMES_AUDITOR_CONTENT_MODEL"):
        _val = os.environ.get(_mv, "").strip()
        if not _val:
            continue
        _c = re.sub(rf"^{_mv}=.*(?:\n|$)", "", _c, flags=re.MULTILINE)
        if _c and not _c.endswith("\n"):
            _c += "\n"
        _c += f"{_mv}={_val}\n"
    _ae.write_text(_c, encoding="utf-8")

# 1d. Dedicated OpenRouter key override (resolved in §1b above). The §1 sync loop
#     wrote the SHARED OPENROUTER_API_KEY into the auditor .env; if a dedicated
#     HERMES_AUDITOR_OPENROUTER_API_KEY is set, replace it here so the auditor's
#     model spend is isolated from the content fleet's shared key and its weekly
#     cap. No-op (keeps the shared key as fallback) when the dedicated one is
#     unset. Runs AFTER the §1 loop so this override always wins.
if auditor_openrouter_key and (profiles_root / "auditor" / "SOUL.md").exists():
    _ae = profiles_root / "auditor" / ".env"
    _c = _ae.read_text(encoding="utf-8") if _ae.exists() else ""
    _c = re.sub(r"^OPENROUTER_API_KEY=.*(?:\n|$)", "", _c, flags=re.MULTILINE)
    if _c and not _c.endswith("\n"):
        _c += "\n"
    _c += f"OPENROUTER_API_KEY={auditor_openrouter_key}\n"
    _ae.write_text(_c, encoding="utf-8")
    print("[03-biglobster] Auditor profile pinned to dedicated OpenRouter key")

# 2. Re-assert runtime-critical config keys (idempotent). docker/config.yaml
#    is the first-boot source of truth; here we only force the keys that must
#    track the intended deploy even on volumes seeded before a change.
#    Applied to BOTH the main config.yaml and every per-profile config.yaml so
#    new profiles created via `hermes profile create` get working provider
#    settings immediately without requiring a manual setup step.
import yaml

overrides = {
    ("web", "backend"): "exa",
    ("image_gen", "provider"): "openrouter",
    ("video_gen", "provider"): "huggingface",
    ("memory", "memory_char_limit"): 6000,
    ("memory", "user_char_limit"): 3000,
    # Tool-iteration budget per agent run. Cron uses this as max_iterations
    # (cron/scheduler.py), and 60 was too tight for heavy jobs like the SEO/GEO
    # cron — they exhausted it mid-run, so the run ended completed=False and the
    # model's summary surfaced as a RuntimeError. Raised to 90 (run_agent's own
    # default). Enforced on main + every profile so the budget is uniform.
    ("agent", "max_turns"): 90,
}
default_model = os.environ.get("HERMES_DEFAULT_MODEL", "")

# Source of truth for which Telegram thread each profile owns: the per-profile
# routing.env bundled in the image. The same file already drives outbound
# delivery (TELEGRAM_HOME_CHANNEL_THREAD_ID, injected into each profile's .env);
# we reuse it to derive the INBOUND topic->profile bindings too.
PROFILES_SRC = Path("/opt/hermes/docker/profiles")

def _reconcile_group_topics(cfg):
    """Ensure inbound topic->profile bindings exist in
    telegram.extra.group_topics, derived from each bundled profile's
    routing.env. The live bindings were only ever set by hand (via the panel),
    so a fresh/rebuilt volume would lose all topic routing — every message would
    fall through to the default profile. Rebuilding them here makes routing
    reproducible from the image (DR) and back-fills any missing binding on
    existing volumes. Conservative: only ADDS a chat/topic entry or corrects a
    topic's `profile`; never removes user-defined topics, renames existing ones,
    or touches other telegram config (allowed_chats, reactions, token, ...).
    Returns True if cfg changed."""
    if not PROFILES_SRC.is_dir():
        return False
    changed = False
    for renv in sorted(PROFILES_SRC.glob("*/routing.env")):
        pname = renv.parent.name
        vals = {}
        for line in renv.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                vals[k.strip()] = v.strip()
        chat = vals.get("TELEGRAM_HOME_CHANNEL")
        thread = vals.get("TELEGRAM_HOME_CHANNEL_THREAD_ID")
        if not chat or not thread:
            continue
        try:
            thread = int(thread)
        except ValueError:
            continue
        tg = cfg.setdefault("telegram", {})
        if not isinstance(tg, dict):
            return changed
        extra = tg.setdefault("extra", {})
        if not isinstance(extra, dict):
            return changed
        gts = extra.get("group_topics")
        if not isinstance(gts, list):
            gts = []
            extra["group_topics"] = gts
        chat_entry = next(
            (e for e in gts if isinstance(e, dict) and str(e.get("chat_id")) == str(chat)),
            None,
        )
        if chat_entry is None:
            chat_entry = {"chat_id": chat, "topics": []}
            gts.append(chat_entry)
            changed = True
        topics = chat_entry.setdefault("topics", [])
        if not isinstance(topics, list):
            continue
        topic = next(
            (t for t in topics if isinstance(t, dict) and t.get("thread_id") == thread),
            None,
        )
        if topic is None:
            topics.append({"name": pname, "profile": pname, "thread_id": thread})
            changed = True
        elif topic.get("profile") != pname:
            topic["profile"] = pname
            changed = True
    return changed

def _reconcile_config(config_path, label, is_rented=False):
    if not config_path.exists():
        print(f"[03-biglobster] {label}: config.yaml not present yet — skipping")
        return
    try:
        cfg = yaml.safe_load(config_path.read_text()) or {}
        changed = False
        for (section, key), val in overrides.items():
            if not isinstance(cfg.get(section), dict):
                cfg[section] = {}
            if cfg[section].get(key) != val:
                cfg[section][key] = val
                changed = True
        # Rented tenants: force web research onto the free ddgs backend,
        # never the "web.backend": "exa" override above. Deliberately a
        # MORE SPECIFIC key (search_backend, not backend) — the resolver
        # (agent/web_search_registry.py get_active_search_provider) reads
        # search_backend first and only falls back to backend when it's
        # unset, so this wins without having to touch/remove the generic
        # override. Forces the provider even before the ddgs package is
        # physically installed on a fresh tenant (its own lazy-install
        # fires on first real search — plugins/web/ddgs/provider.py). See
        # issue #174: EXA_API_KEY billed every tenant's web_search calls to
        # BigLobster's own Exa account; §1 above stops handing tenants the
        # key at all, this is the other half — without it, a tenant with a
        # stale key already on disk (or none at all) would still either
        # bill us or hard-fail with "no provider configured".
        if is_rented:
            if not isinstance(cfg.get("web"), dict):
                cfg["web"] = {}
            if cfg["web"].get("search_backend") != "ddgs":
                cfg["web"]["search_backend"] = "ddgs"
                changed = True
        # Preserve the curated image_gen.openrouter.model only if unset.
        ig = cfg.get("image_gen")
        if isinstance(ig, dict):
            ig_or = ig.get("openrouter")
            if not isinstance(ig_or, dict):
                ig_or = {}
            if ig_or.get("model") in (None, ""):
                ig_or["model"] = "x-ai/grok-imagine-image-quality"
                ig["openrouter"] = ig_or
                changed = True
        # model.default from HERMES_DEFAULT_MODEL when provided.
        # AUDITOR EXEMPTION: the auditor profile's base model drives a tool-calling
        # ORCHESTRATOR loop (gh / python -m auditor.*), not prose. The free,
        # rate-limited owl-alpha default makes weak tool decisions and derails into
        # long flailing runs (blocked rm/script/auth.json retries) that take ~25min
        # and starve every other cron (agent runs serialize). Pin the auditor to a
        # reliable cheap orchestrator instead — tunable from Zeabur via
        # HERMES_AUDITOR_ORCHESTRATOR_MODEL, mirroring the §1c review-model knobs.
        # The reviewer models (auditor/llm.py, §1c) are separate and unaffected.
        # The default names the DATED slug on purpose: the undated alias
        # `deepseek/deepseek-v4-flash` resolves to the 0423 snapshot on
        # OpenRouter ($0.087/M input) while `-0731` is $0.065/M — 25% cheaper
        # on the input tokens that are ~99% of this orchestrator's bill
        # (tasks/token-optimization.md). Never let the auditor fall back to the
        # undated alias.
        eff_model = default_model
        if label == "auditor":
            eff_model = os.environ.get(
                "HERMES_AUDITOR_ORCHESTRATOR_MODEL",
                "deepseek/deepseek-v4-flash-0731").strip()
        if eff_model:
            mv = cfg.get("model")
            if isinstance(mv, dict):
                cur = mv.get("default")
            elif isinstance(mv, str):
                cur = mv.strip()
            else:
                cur = None
            if cur != eff_model:
                if isinstance(mv, dict):
                    mv["default"] = eff_model
                    cfg["model"] = mv
                else:
                    cfg["model"] = {"default": eff_model, "provider": "openrouter", "base_url": ""}
                changed = True
        # fallback_model must stay a DIFFERENT model than model.default — a
        # fallback that matches the main model is a no-op retry against the
        # same dead/rate-limited upstream. Incident 2026-07-02: swapping the
        # main model to tencent/hy3-preview also clobbered fallback_model to
        # the same value on 4 profiles (main, biglobster, finview, grow-shop,
        # socialagenda), silently disabling fallback account-wide. Reconciled
        # here like model.default so this can't drift again. Auditor is
        # exempt — its fallback path is the DeepSeek pin below, not this key.
        if label != "auditor":
            fb_model = os.environ.get(
                "HERMES_FALLBACK_MODEL", "deepseek/deepseek-v4-flash").strip()
            if fb_model:
                fbv = cfg.get("fallback_model")
                if not isinstance(fbv, dict):
                    fbv = {}
                if fbv.get("model") != fb_model:
                    fbv["model"] = fb_model
                    fbv["provider"] = "openrouter"
                    cfg["fallback_model"] = fbv
                    changed = True
        # AUDITOR: pin OpenRouter provider routing to DeepSeek's own endpoint.
        # The orchestrator cached erratically (56% hit) DESPITE stable
        # session_id — OpenRouter session-stickiness is best-effort, so the
        # deepseek-v4-flash orchestrator needs explicit provider pinning for
        # a warm prompt cache (input tokens are 99% of its cost; see
        # tasks/token-optimization.md). Safe: allow_fallbacks stays on (a
        # DeepSeek outage degrades instead of breaking), and the "deepseek"
        # slug is a no-op for non-deepseek models. Auditor profile ONLY —
        # pinning the main profile is deliberately deferred until the
        # deepseek-v4-pro migration (CEO decision, token-optimization.md).
        if label == "auditor":
            pr = cfg.get("provider_routing")
            if not isinstance(pr, dict):
                pr = {}
                cfg["provider_routing"] = pr
            if pr.get("order") != ["deepseek"]:
                pr["order"] = ["deepseek"]
                changed = True
        # Enable the Langfuse observability plugin when its keys are present.
        # The recorder is OPT-IN via plugins.enabled — the env keys alone do
        # NOT activate it (the #1 source of "I set the keys but see no traces").
        # Append the plugin's registry key (loader also accepts the bare
        # "langfuse") WITHOUT clobbering any other enabled plugins. Idempotent:
        # once present, later boots make no change. Gated on the keys so we
        # never enable a recorder that has nowhere to send traces.
        if os.environ.get("HERMES_LANGFUSE_PUBLIC_KEY") and os.environ.get("HERMES_LANGFUSE_SECRET_KEY"):
            plugins_cfg = cfg.get("plugins")
            if not isinstance(plugins_cfg, dict):
                plugins_cfg = {}
                cfg["plugins"] = plugins_cfg
            enabled = plugins_cfg.get("enabled")
            if not isinstance(enabled, list):
                enabled = []
            if "observability/langfuse" not in enabled and "langfuse" not in enabled:
                enabled.append("observability/langfuse")
                plugins_cfg["enabled"] = enabled
                changed = True
        # Ensure the read-only GSC MCP server is registered — biglobster
        # profile only. docker/config.yaml ships this block, but that is only
        # the first-boot seed: an existing volume keeps its own config.yaml
        # (which starts as `mcp_servers: {}`), so the image change never reaches
        # the running agent and the SEO/GEO cron silently runs without Search
        # Console data. Reconcile it here like the other runtime-critical keys.
        # Scoped to the `biglobster` profile (the biglobster.top website lane,
        # `label == "biglobster"`): the tool reads biglobster.top data and must
        # NOT leak into the owner (`main`) profile or other tenant profiles
        # (finview/grow-shop/socialagenda). The credential is interpolated from
        # the env at load time (tools/mcp_tool.py), so only the ${...}
        # placeholder is written here, never the key. See optional-mcps/gsc/.
        if label == "biglobster":
            servers = cfg.get("mcp_servers")
            if not isinstance(servers, dict):
                servers = {}
                cfg["mcp_servers"] = servers
            gsc_cfg = {
                "command": "/opt/hermes/.venv/bin/python",
                "args": ["/opt/hermes/optional-mcps/gsc/server.py"],
                "env": {"GSC_SERVICE_ACCOUNT_B64": "${GSC_SERVICE_ACCOUNT_B64}"},
                "timeout": 60,
            }
            if servers.get("gsc") != gsc_cfg:
                servers["gsc"] = gsc_cfg
                changed = True
        # The owner (`main`) profile must NOT carry the GSC server. Volumes
        # provisioned before GSC moved to the biglobster profile still have it
        # written onto main's config.yaml (the old `label == "main"` gate);
        # actively shed it so the owner drops the biglobster.top credential and
        # the tool can't run in the wrong lane. Idempotent on clean volumes.
        if label == "main":
            servers = cfg.get("mcp_servers")
            if isinstance(servers, dict) and "gsc" in servers:
                del servers["gsc"]
                changed = True
            # Inbound topic->profile routing lives only on the main profile's
            # config. Rebuild it from the profiles' routing.env so it survives a
            # volume rebuild (DR) and back-fills missing bindings.
            if _reconcile_group_topics(cfg):
                changed = True
        if changed:
            config_path.write_text(yaml.dump(cfg, default_flow_style=False))
            print(f"[03-biglobster] {label}: reconciled config.yaml keys")
        else:
            print(f"[03-biglobster] {label}: config.yaml keys already current")
    except Exception as e:
        print(f"[03-biglobster] Warning: {label} config.yaml reconcile failed: {e}")

# Main profile
_reconcile_config(home / "config.yaml", "main")

# Per-profile configs — same overrides so every profile gets a working
# model/provider out of the box. SOUL.md is the real-profile marker.
if profiles_root.is_dir():
    for prof in sorted(p for p in profiles_root.iterdir() if p.is_dir()):
        if not (prof / "SOUL.md").exists():
            continue
        _reconcile_config(
            prof / "config.yaml", prof.name,
            is_rented=_is_rented_tenant(prof / ".env"),
        )
PYEOF

# --- 2b: per-profile routing env injection (every boot, not seed-once) ---
# Routing vars (Telegram home channel, cron thread IDs) are profile-specific —
# they cannot be in the shared inject list, and they must win over any stale
# global value in os.environ so cron jobs deliver to the correct forum thread.
# docker/profiles/<name>/routing.env is the source of truth (version-controlled).
# Policy: upsert on every boot so a thread change in the image takes effect
# on next container restart without requiring manual volume edits.
if [ -d "$INSTALL_DIR/docker/profiles" ]; then
    for src_routing in "$INSTALL_DIR/docker/profiles"/*/routing.env; do
        [ -f "$src_routing" ] || continue
        prof_name=$(basename "$(dirname "$src_routing")")
        prof_env="$HERMES_HOME/profiles/$prof_name/.env"
        [ -f "$HERMES_HOME/profiles/$prof_name/SOUL.md" ] || continue
        as_hermes "$PY" - "$src_routing" "$prof_env" <<'PYEOF' || echo "[03-biglobster] Warning: routing.env inject failed for $prof_name"
import sys, re
from pathlib import Path
src, dest = Path(sys.argv[1]), Path(sys.argv[2])
routing_vars = {}
for line in src.read_text().splitlines():
    line = line.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    k, _, v = line.partition("=")
    routing_vars[k.strip()] = v.strip()
content = dest.read_text(encoding="utf-8") if dest.exists() else ""
for var, val in routing_vars.items():
    if re.search(rf"^{re.escape(var)}=", content, re.MULTILINE):
        content = re.sub(rf"^{re.escape(var)}=.*", f"{var}={val}", content, flags=re.MULTILINE)
    else:
        sep = "" if (not content or content.endswith("\n")) else "\n"
        content += f"{sep}{var}={val}\n"
dest.write_text(content, encoding="utf-8")
print(f"[03-biglobster] Injected routing.env into profiles/{Path(dest).parent.name}/.env")
PYEOF
    done
fi

# --- 3: seed agent memory on first boot ---
if [ ! -f "$HERMES_HOME/memories/MEMORY.md" ] && [ -f "$INSTALL_DIR/docker/MEMORY.md" ]; then
    as_hermes cp "$INSTALL_DIR/docker/MEMORY.md" "$HERMES_HOME/memories/MEMORY.md" \
        && echo "[03-biglobster] Seeded agent memory from docker/MEMORY.md"
fi

# --- 4: git HTTPS credential for GITHUB_TOKEN (refreshed on every boot) ---
# HOME=/opt/data so --global writes to $HERMES_HOME/.gitconfig on the volume.
# .git-credentials is re-written each boot so a rotated token takes effect
# without requiring a rebuild or manual intervention.
#
# The SAME credential is mirrored into every profile's subprocess HOME
# ($HERMES_HOME/profiles/<name>/home). Per-profile cron jobs run git with
# that dir as HOME (see hermes_constants.get_subprocess_home()), so they read
# a DIFFERENT .gitconfig / .git-credentials than the default profile's. Before
# this loop, section 4 only refreshed the default, so after a $GITHUB_TOKEN
# rotation every profile home kept a STALE (revoked) token and profile-scoped
# push/clone broke — the failure hand-fixed for the finview profile on
# 2026-06-12. SOUL.md is the real-profile marker, same as sections 1/2/5;
# the home/ subdir is created on demand so a profile that never had one still
# gets working credentials (grow-shop hit exactly this on 2026-06-15).
if [ -n "$GITHUB_TOKEN" ]; then
    # Resolve the shared token's GitHub login FIRST — before writing any
    # credential from it. Two uses: (a) the gh hosts.yml `user:` field written
    # per profile below (cosmetic — gh authenticates via oauth_token, so a
    # stale/blank user still authenticates; the hand-placed finview hosts.yml
    # proved this, 2026-06-25); (b) an identity tripwire (next block). Falls
    # back to the deployment owner if the API is unreachable at boot, so a
    # transient network blip never trips the guard or blocks git.
    gh_login=$(HOME="$HERMES_HOME" GH_TOKEN="$GITHUB_TOKEN" gh api user --jq .login 2>/dev/null || true)
    [ -n "$gh_login" ] || gh_login="br41s"

    # TRIPWIRE: the shared/content token must be the CEO identity, NEVER the
    # hermes-auditor bot. If it positively resolves to hermes-auditor, refuse to
    # write ANY shared/content credential from it (the default-profile store
    # below AND every per-profile home). Writing it makes content agents push
    # and open PRs AS the reviewer, which the auditor by design refuses to
    # review or merge (SOUL.md: "Never review or merge your own commits") — so a
    # whole night of content PRs silently went unaudited on 2026-07-15 when the
    # auditor PAT briefly sat in GITHUB_TOKEN/GH_TOKEN. We LEAVE any existing
    # on-disk credentials untouched: the last good boot wrote the correct CEO
    # identity, so content keeps authoring correctly (or, on a fresh volume with
    # none, simply fails to push) — never as the reviewer. Loud, because the fix
    # is an env change: move the bot PAT to HERMES_AUDITOR_GITHUB_TOKEN and set
    # GITHUB_TOKEN back to the CEO token.
    if [ "$gh_login" = "hermes-auditor" ]; then
        echo "[03-biglobster] GUARD: shared GITHUB_TOKEN resolves to hermes-auditor" \
             "— refusing to write shared/content git credentials from it; content" \
             "PRs would be authored by the reviewer and go unaudited. Move the bot" \
             "PAT to HERMES_AUDITOR_GITHUB_TOKEN and restore the CEO token in" \
             "GITHUB_TOKEN. Existing on-disk credentials left as-is." >&2
    fi

    if [ "$gh_login" != "hermes-auditor" ]; then
        HOME="$HERMES_HOME" git config --global credential.helper store
        HOME="$HERMES_HOME" git config --global user.name "Hermes Agent"
        HOME="$HERMES_HOME" git config --global user.email "hermes@agent.local"
        printf 'https://x-access-token:%s@github.com\n' "$GITHUB_TOKEN" > "$HERMES_HOME/.git-credentials"
        chmod 600 "$HERMES_HOME/.git-credentials"
        chown hermes:hermes "$HERMES_HOME/.git-credentials" 2>/dev/null || true
        echo "[03-biglobster] git HTTPS credential configured (x-access-token)"
    fi

    # Per-profile subprocess homes — run as hermes (profile homes are
    # hermes-owned). Idempotent + non-fatal, matching the script's contract.
    # We CREATE the home/ dir for every real profile (SOUL.md present) rather
    # than skipping profiles that lack one: a profile onboarded before home/
    # was bootstrapped (or via a path that didn't make it) would otherwise
    # silently never get git/gh auth — the failure hand-fixed for grow-shop on
    # 2026-06-15. `mkdir -p` is idempotent, and get_subprocess_home() then
    # resolves to this populated dir for the delegate lane. Skipped entirely
    # when the tripwire above fired (shared token is the auditor identity).
    if [ "$gh_login" != "hermes-auditor" ] && [ -d "$HERMES_HOME/profiles" ]; then
        for prof_dir in "$HERMES_HOME/profiles"/*/; do
            [ -f "${prof_dir}SOUL.md" ] || continue
            prof_name=$(basename "$prof_dir")
            # The auditor profile's git/gh identity is provisioned EXCLUSIVELY
            # by §4b below (dedicated hermes-auditor bot token) — skip it here
            # entirely, not just the hosts.yml write. Previously only the
            # hosts.yml write was skipped, so this loop still wrote the SHARED
            # (human-linked) token into the auditor's .git-credentials; if §4b
            # then no-op'd because HERMES_AUDITOR_GITHUB_TOKEN was transiently
            # unset, that shared credential was left in place with no warning
            # — the auditor could then git/gh AS that human account instead of
            # failing closed (found 2026-07-15, biglobster PR #356).
            [ "$prof_name" = "auditor" ] && continue
            prof_home="${prof_dir}home"
            as_hermes mkdir -p "$prof_home"
            HOME="$prof_home" as_hermes git config --global credential.helper store \
                || echo "[03-biglobster] Warning: git config failed for profile $prof_name (non-fatal)"
            HOME="$prof_home" as_hermes git config --global user.name "Hermes Agent" 2>/dev/null || true
            HOME="$prof_home" as_hermes git config --global user.email "hermes@agent.local" 2>/dev/null || true
            printf 'https://x-access-token:%s@github.com\n' "$GITHUB_TOKEN" > "$prof_home/.git-credentials"
            chmod 600 "$prof_home/.git-credentials"
            chown hermes:hermes "$prof_home/.git-credentials" 2>/dev/null || true
            echo "[03-biglobster] git HTTPS credential configured for profile: $prof_name"

            # gh CLI auth: on-disk hosts.yml so `gh pr ...` authenticates in the
            # cron lane, which exports NO GH_TOKEN into the terminal subprocess
            # (only git's on-disk .git-credentials is honoured there). Without
            # this, profile crons can git push but every `gh pr create` 401s —
            # the FinView Content Gap Hunter failure (2026-06-25), the same gap
            # PR #73 closed for the auditor.
            as_hermes mkdir -p "$prof_home/.config/gh"
            printf 'github.com:\n    oauth_token: %s\n    git_protocol: https\n    user: %s\n' \
                "$GITHUB_TOKEN" "$gh_login" > "$prof_home/.config/gh/hosts.yml"
            chmod 600 "$prof_home/.config/gh/hosts.yml"
            chown -R hermes:hermes "$prof_home/.config" 2>/dev/null || true
            echo "[03-biglobster] gh hosts.yml provisioned for profile: $prof_name"
        done
    fi
else
    echo "[03-biglobster] GITHUB_TOKEN not set — git HTTPS credential skipped"
fi

# --- 4b: auditor profile git auth — pin to the hermes-auditor bot token ---
# The auditor reviews (and, once trusted, pushes fix commits) under its OWN
# GitHub identity, distinct from the agents it reviews. Resolve
# HERMES_AUDITOR_GITHUB_TOKEN (env first, then the durable main .env, mirroring
# the GITHUB_TOKEN resolution in the preamble) and write it ONLY into the auditor
# profile's subprocess home — the shared agent token must never reach the auditor
# identity. Independent of the shared-token branch above so it runs even when
# GITHUB_TOKEN is unset. Non-fatal + idempotent, matching the script's contract.
AUDITOR_TOKEN="${HERMES_AUDITOR_GITHUB_TOKEN:-}"
if [ -z "$AUDITOR_TOKEN" ] && [ -f "$HERMES_HOME/.env" ]; then
    AUDITOR_TOKEN=$(grep -E '^HERMES_AUDITOR_GITHUB_TOKEN=' "$HERMES_HOME/.env" 2>/dev/null \
        | tail -n1 | cut -d= -f2-)
fi
auditor_home="$HERMES_HOME/profiles/auditor/home"
if [ -f "$HERMES_HOME/profiles/auditor/SOUL.md" ]; then
    if [ -n "$AUDITOR_TOKEN" ]; then
        as_hermes mkdir -p "$auditor_home"
        HOME="$auditor_home" as_hermes git config --global credential.helper store \
            || echo "[03-biglobster] Warning: git config failed for auditor (non-fatal)"
        HOME="$auditor_home" as_hermes git config --global user.name "hermes-auditor" 2>/dev/null || true
        HOME="$auditor_home" as_hermes git config --global user.email \
            "${HERMES_AUDITOR_GIT_EMAIL:-hermes-auditor@users.noreply.github.com}" 2>/dev/null || true
        printf 'https://x-access-token:%s@github.com\n' "$AUDITOR_TOKEN" > "$auditor_home/.git-credentials"
        chmod 600 "$auditor_home/.git-credentials"
        chown hermes:hermes "$auditor_home/.git-credentials" 2>/dev/null || true
        echo "[03-biglobster] Auditor git credential pinned to hermes-auditor identity"
        # gh CLI auth: on-disk hosts.yml so `gh` authenticates WITHOUT an env token.
        # The cron lane does not export GH_TOKEN into the terminal subprocess (only
        # git's on-disk .git-credentials is honoured there), so without this every
        # `gh pr ...` 401s and the auditor cron flails (prod 2026-06-24). gh reads
        # $HOME/.config/gh/hosts.yml, and the auditor's subprocess HOME is here.
        as_hermes mkdir -p "$auditor_home/.config/gh"
        printf 'github.com:\n    oauth_token: %s\n    git_protocol: https\n    user: hermes-auditor\n' "$AUDITOR_TOKEN" \
            > "$auditor_home/.config/gh/hosts.yml"
        chmod 600 "$auditor_home/.config/gh/hosts.yml"
        chown -R hermes:hermes "$auditor_home/.config" 2>/dev/null || true
        echo "[03-biglobster] Auditor gh hosts.yml provisioned"

        # IDENTITY TRIPWIRE (mirror of the §4 content guard, opposite direction):
        # the token just written MUST authenticate as hermes-auditor. If
        # HERMES_AUDITOR_GITHUB_TOKEN is crossed to a NON-auditor identity — e.g.
        # the CEO's own PAT, as happened in the 2026-07 Frankfurt secret rotation
        # (auditor reviews then posted under `br41s`, FinView #168) — the
        # auditor would review/merge under that identity, breaking the "reviewer
        # distinct from author" invariant and making its reviews look like the
        # CEO's. Verify and, on a positive mismatch, STRIP the credential (fail
        # closed) rather than review as the wrong account. A blank/unreachable
        # API skips the check (never block the auditor on a transient blip).
        _aud_login=$(HOME="$auditor_home" GH_TOKEN="$AUDITOR_TOKEN" gh api user --jq .login 2>/dev/null || true)
        if [ -n "$_aud_login" ] && [ "$_aud_login" != "hermes-auditor" ]; then
            rm -f "$auditor_home/.git-credentials" "$auditor_home/.config/gh/hosts.yml" 2>/dev/null || true
            echo "[03-biglobster] GUARD: HERMES_AUDITOR_GITHUB_TOKEN resolves to" \
                 "'$_aud_login', not hermes-auditor — stripped the auditor credential" \
                 "(fail-closed). Set the hermes-auditor bot PAT in" \
                 "HERMES_AUDITOR_GITHUB_TOKEN." >&2
        fi
    else
        # Fail CLOSED, never fall back to the shared token: remove any stale
        # git-credentials/hosts.yml so git/gh simply have NO auth for this
        # profile (a loud 401 / push failure) instead of silently keeping
        # whatever was written on a prior boot, or — worse — the shared
        # human-linked credential the §4 loop above no longer even writes
        # here. A quiet no-op in this branch is exactly what let the auditor
        # authenticate as the CEO's own GitHub account go unnoticed before
        # (found 2026-07-15, biglobster PR #356).
        rm -f "$auditor_home/.git-credentials" "$auditor_home/.config/gh/hosts.yml" 2>/dev/null || true
        echo "[03-biglobster] WARNING: HERMES_AUDITOR_GITHUB_TOKEN not set — auditor profile has NO git/gh credential this boot (fail-closed, will never fall back to the shared token)"
    fi
fi

# --- 4c: auditor dedup-state dir must be hermes-owned (persist reviewed ledger) ---
# The auditor cron runs as the hermes user and persists its reviewed-PR dedup
# ledger to $HERMES_HOME/auditor/state.json (auditor/pending.py _state_path()).
# If that dir/file is root-owned, the hermes cron cannot write it: every
# mark_reviewed() raises PermissionError, the `seen` set never grows, and every
# 6h poll + every webhook trigger RE-REVIEWS every open PR at the same head SHA
# — the duplicate-review storm observed on FinView #168 (2026-07-22), whose
# state.json was still root-owned and stale from 2026-06-25 after the Frankfurt
# volume migration carried ownership over as root. Create it if missing and
# force hermes ownership every boot. cont-init runs as root here, so the chown
# succeeds; non-fatal, matching the script's contract.
mkdir -p "$HERMES_HOME/auditor" 2>/dev/null || true
chown -R hermes:hermes "$HERMES_HOME/auditor" 2>/dev/null || true
echo "[03-biglobster] Auditor state dir ownership enforced (hermes:hermes)"

# --- 5: seed per-profile bootstrap files from docker/profiles/<name>/ (once) ---
# Files bundled in the image under docker/profiles/<name>/ are copied into the
# corresponding volume profile directory on first use (i.e. only if the
# destination file does not already exist). This lets the image ship per-profile
# defaults (repos.txt, etc.) without overwriting files the agent has written.
# Guard: profile must already exist on the volume (marker: SOUL.md present).
if [ -d "$INSTALL_DIR/docker/profiles" ]; then
    for src_dir in "$INSTALL_DIR/docker/profiles"/*/; do
        [ -d "$src_dir" ] || continue
        prof_name=$(basename "$src_dir")
        prof_vol="$HERMES_HOME/profiles/$prof_name"
        [ -f "$prof_vol/SOUL.md" ] || continue
        for src_file in "$src_dir"*; do
            [ -f "$src_file" ] || continue
            fname=$(basename "$src_file")
            dest="$prof_vol/$fname"
            if [ ! -f "$dest" ]; then
                as_hermes cp "$src_file" "$dest" \
                    && echo "[03-biglobster] Seeded profiles/$prof_name/$fname"
            fi
        done
    done
fi

# --- 5b: ensure the git-auth instruction in each profile's SOUL.md (idempotent) ---
# Root cause of the repeated profile-lane git breakages: the agent tries to
# "fix" auth itself — rewriting .git-credentials, embedding a token in the
# remote URL, or switching to SSH. Because the token it sees is redacted to
# ***, those writes CORRUPT the working credential (grow-shop's .git-credentials
# was blanked this way on 2026-06-15). Auth is already ambient (credential
# helper for git, ~/.config/gh/hosts.yml for gh — both written above), so the
# agent must never touch it. Append a managed block to each real profile's
# SOUL.md when absent. grep-marker keeps it idempotent and reaches EXISTING
# profiles on the next boot, mirroring §6's MEMORY.md workspace-note pattern.
if [ -d "$HERMES_HOME/profiles" ]; then
    for prof_dir in "$HERMES_HOME/profiles"/*/; do
        soul="${prof_dir}SOUL.md"
        [ -f "$soul" ] || continue
        if ! grep -q "Git Auth (managed" "$soul" 2>/dev/null; then
            prof_name=$(basename "$prof_dir")
            printf '\n## Git Auth (managed — do not edit)\n- Auth is ambient: `git push` uses the stored credential helper and `gh` uses its on-disk config (`~/.config/gh/hosts.yml`). Both are provisioned for you.\n- NEVER write, edit, or recreate `.git-credentials` or `~/.config/gh/hosts.yml`, and NEVER put a token in a remote URL. The token you see is redacted to `***`, so writing it BLANKS the working credential and breaks all pushes.\n- NEVER switch a remote to SSH or generate SSH keys. Remotes stay tokenless `https://github.com/<owner>/<repo>.git`.\n- If a push or `gh` command fails auth, report it to the user verbatim — do not try to fix credentials yourself.\n' \
                | as_hermes tee -a "$soul" > /dev/null \
                && echo "[03-biglobster] Appended Git Auth block to profiles/$prof_name/SOUL.md"
        fi
    done
fi

# --- 5c: seed the incident-watcher cron script (overwrite every boot to stay current) ---
# Phase 0 incident watcher: an hourly no_agent cron job runs this wrapper, which
# execs incidents/sweep.py from the install dir (so `incidents` imports) with
# HERMES_HOME provided by the cron runner. Empty stdout = silent delivery.
# Register the job ONCE (after deploy, in the container shell):
#   hermes cron create "every 1h" --no-agent --script incident_sweep.sh \
#     --deliver "telegram:<chat_id>:1904" --name incident-watcher
as_hermes mkdir -p "$HERMES_HOME/scripts"
cat > "$HERMES_HOME/scripts/incident_sweep.sh" <<'SWEEP'
#!/bin/bash
# Managed by docker/cont-init.d/03-biglobster-config — do not edit on the volume.
cd /opt/hermes 2>/dev/null || exit 0
exec .venv/bin/python -m incidents.sweep
SWEEP
chmod +x "$HERMES_HOME/scripts/incident_sweep.sh"
chown hermes:hermes "$HERMES_HOME/scripts/incident_sweep.sh" 2>/dev/null || true
echo "[03-biglobster] Seeded scripts/incident_sweep.sh"

# --- 5d: seed the upstream-drift cron script (overwrite every boot to stay current) ---
# Weekly watchdog: warns when our fork falls behind upstream NousResearch's
# newest release tag. Merge cost is superlinear in ELAPSED TIME (10 days of
# drift measured ~23 conflicted files; 2 months measured 44), so the point is to
# nag before a merge turns into a rewrite-reapplication exercise. Prints nothing
# under the threshold, so delivery stays silent until it matters.
#
# In here it runs in REMOTE mode: the image excludes .git, so it asks the GitHub
# API for the newest tag and compares against the UPSTREAM_VERSION file. Run it
# on a clone for the real conflict count. Runbook: tasks/upstream-merge-hygiene.md
# Register the job ONCE (after deploy, in the container shell):
#   hermes cron create "0 9 * * 1" --no-agent --script upstream_drift.sh \
#     --deliver "telegram:<chat_id>:1904" --name upstream-drift
cat > "$HERMES_HOME/scripts/upstream_drift.sh" <<'DRIFT'
#!/bin/bash
# Managed by docker/cont-init.d/03-biglobster-config — do not edit on the volume.
cd /opt/hermes 2>/dev/null || exit 0
# Exit 1 means "drift over threshold", which is a REPORT, not a failure — the
# cron runner would otherwise mark the job errored every week it has something
# to say. Its stdout is the message; empty stdout stays silent.
.venv/bin/python scripts/upstream_drift.py || true
DRIFT
chmod +x "$HERMES_HOME/scripts/upstream_drift.sh"
chown hermes:hermes "$HERMES_HOME/scripts/upstream_drift.sh" 2>/dev/null || true
echo "[03-biglobster] Seeded scripts/upstream_drift.sh"

# --- 6: per-profile repo sync (clone on first boot, pull on subsequent boots) ---
# Any profile with a repos.txt gets its listed GitHub repos cloned into
# <profile>/workspace/<repo-name>/. Format: one "owner/repo" per line;
# blank lines and lines starting with # are ignored.
# git HTTPS credentials are already configured by section 4.
# Non-fatal: a clone/pull failure prints a warning and boot continues.
if [ -d "$HERMES_HOME/profiles" ]; then
    for prof_dir in "$HERMES_HOME/profiles"/*/; do
        repos_file="${prof_dir}repos.txt"
        [ -f "$repos_file" ] || continue
        workspace="${prof_dir}workspace"
        as_hermes mkdir -p "$workspace"
        while IFS= read -r repo || [ -n "$repo" ]; do
            case "$repo" in ''|'#'*) continue ;; esac
            repo_name="${repo##*/}"
            target="$workspace/$repo_name"
            if [ -d "$target/.git" ]; then
                # Normalize the remote to tokenless https every boot. An embedded
                # token (https://x-access-token:TOKEN@github.com/…) gets redacted
                # to *** in the agent's view, so the agent concludes auth is
                # broken and detours to generating an SSH key — the grow-shop
                # landing failure on 2026-06-15. Tokenless lets the credential
                # helper supply the token transparently. Idempotent + non-fatal.
                HOME="$HERMES_HOME" as_hermes git -C "$target" remote set-url origin \
                    "https://github.com/$repo.git" 2>/dev/null || true
                echo "[03-biglobster] Pulling $repo"
                # A cron job (e.g. Content Gap Hunter) can leave this clone on a
                # feature branch after opening a PR. --ff-only then fails with
                # "Not possible to fast-forward" against that branch's moved/
                # squashed remote history — same failure mode section 6b hit
                # for the BigLobster site checkouts. Land back on main first;
                # non-fatal like every other step here.
                HOME="$HERMES_HOME" as_hermes git -C "$target" checkout --quiet main 2>/dev/null \
                    || echo "[03-biglobster] Warning: checkout main failed for $repo (non-fatal)"
                HOME="$HERMES_HOME" as_hermes timeout 120 git -C "$target" pull --ff-only --quiet 2>&1 \
                    || echo "[03-biglobster] Warning: git pull failed/timed out for $repo (non-fatal)"
            else
                echo "[03-biglobster] Cloning $repo (depth 1)"
                HOME="$HERMES_HOME" as_hermes timeout 300 git clone --depth=1 \
                    "https://github.com/$repo.git" "$target" 2>&1 \
                    || echo "[03-biglobster] Warning: git clone failed/timed out for $repo (non-fatal)"
            fi
        done < "$repos_file"
        # One-time: append a workspace note to the profile's MEMORY.md so the
        # agent knows to look in workspace/ for project source code.
        mem_file="${prof_dir}memories/MEMORY.md"
        if [ -f "$mem_file" ] && ! grep -q "workspace/" "$mem_file" 2>/dev/null; then
            prof_name=$(basename "$prof_dir")
            printf '\n§\nProject repos are cloned into workspace/ at every container boot (e.g. workspace/grow-shop-api/). Run `ls workspace/` to see what is available. Use file tools to read source code, configs, and docs from there.\n' \
                | as_hermes tee -a "$mem_file" > /dev/null \
                && echo "[03-biglobster] Appended workspace note to profiles/$prof_name/memories/MEMORY.md"
        fi
    done
fi

# --- 6b: isolated BigLobster site checkouts (one per consuming cron job) ---
# The SEO/GEO cron and the Content Gap Hunter cron both edit the BigLobster
# site repo (br41s/biglobster — the biglobster.top blog under web/blog/).
# They used to share ONE working tree, which collided on branch AND git
# identity: Gap Hunter left the tree on a blog/<slug> feature branch authored
# as "BigLobster <biglobster@biglobster.top>", so the SEO agent's commits
# landed on the wrong branch as the wrong author — never reached main and later
# tripped the "human edit" ledger detector (author != hermes@agent.local). The
# SEO cron PROMPT papered over it (PASO 0: fetch + checkout main + pin identity),
# but that only reset shared state per-run and never covered Gap Hunter.
#
# Root fix: give each job its OWN clone under checkouts/. A separate .git means
# a separate index, HEAD, and (locally pinned) commit identity, so both jobs sit
# on main independently and neither can perturb the other's tree or authorship.
# Point each cron job's workdir at its directory (see BIGLOBSTER_SETUP.md).
# Same idioms and never-fatal contract as section 6: a failed clone/pull/fetch
# prints a warning and boot continues. The git HTTPS credential from section 4
# (default-profile HOME=$HERMES_HOME) supplies auth transparently; the remote is
# kept tokenless so the agent never sees a redacted token in its remote URL.
BIGLOBSTER_SITE_REPO="br41s/biglobster"
checkouts_root="$HERMES_HOME/checkouts"
as_hermes mkdir -p "$checkouts_root"
for ckdir in biglobster-seo biglobster-gaphunter biglobster-infographic biglobster-translation; do
    target="$checkouts_root/$ckdir"
    if [ -d "$target/.git" ]; then
        # Normalize to a tokenless remote (same rationale as section 6).
        HOME="$HERMES_HOME" as_hermes git -C "$target" remote set-url origin \
            "https://github.com/$BIGLOBSTER_SITE_REPO.git" 2>/dev/null || true
        echo "[03-biglobster] Refreshing site checkout $ckdir"
        # Ensure each tree is back on main and current at boot, WITHOUT a hard
        # reset: `checkout main` keeps non-conflicting untracked files (e.g. a
        # cover image the Gap Hunter run left behind), and --ff-only never
        # rewrites local history. Each step is independently non-fatal.
        HOME="$HERMES_HOME" as_hermes timeout 120 git -C "$target" fetch --quiet origin main 2>&1 \
            || echo "[03-biglobster] Warning: git fetch failed/timed out for $ckdir (non-fatal)"
        # Self-heal a dirty TRACKED file blocking the upcoming fast-forward.
        # Found 2026-09-05: a real commit to SOUL.md on origin/main (4ab6335e,
        # 2026-08-12) was single-file-synced into all four checkouts
        # (`git checkout origin/main -- SOUL.md`) without advancing each
        # checkout's own branch pointer, leaving every one of them permanently
        # dirty against their own stale HEAD — checkout+pull below then
        # refused to fast-forward for a MONTH, silently (non-fatal warning,
        # nobody looked, four identical broken checkouts). Only auto-discard
        # when the checkout carries NO commits origin/main doesn't have — i.e.
        # the dirt is pure working-tree noise, never real unmerged work. When
        # local commits ARE ahead (confirmed to actually happen: biglobster-seo
        # carried 4 real SEO commits that had — by luck — already landed
        # upstream via PR #426), do not guess: leave the tree untouched and
        # report it instead via the same jsonl-signal convention the git-guard
        # pre-commit hook uses for blocked-commits.jsonl (incidents/sweep.py
        # picks both up on its hourly pass).
        _ck_dirty=$(HOME="$HERMES_HOME" as_hermes git -C "$target" status --porcelain 2>/dev/null)
        _ck_ahead=$(HOME="$HERMES_HOME" as_hermes git -C "$target" rev-list --count HEAD "^origin/main" 2>/dev/null) \
            || _ck_ahead=0
        if [ -n "$_ck_dirty" ]; then
            if [ "${_ck_ahead:-0}" = "0" ]; then
                HOME="$HERMES_HOME" as_hermes git -C "$target" checkout --quiet -- . 2>/dev/null \
                    && echo "[03-biglobster] Discarded dirty tracked-file state in $ckdir (no local commits at risk)" \
                    || echo "[03-biglobster] Warning: could not clean dirty state in $ckdir (non-fatal)"
            else
                echo "[03-biglobster] Warning: $ckdir is dirty AND $_ck_ahead commit(s) ahead of origin/main — leaving untouched, logging to incident watcher"
                as_hermes mkdir -p "$HERMES_HOME/incidents" 2>/dev/null
                _ck_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
                printf '{"ts":"%s","checkout":"%s","ahead":%s,"reason":"dirty tracked file + local commits ahead of origin/main block the fast-forward pull"}\n' \
                    "$_ck_ts" "$ckdir" "$_ck_ahead" \
                    | as_hermes tee -a "$HERMES_HOME/incidents/checkout-drift.jsonl" > /dev/null
            fi
        fi
        HOME="$HERMES_HOME" as_hermes git -C "$target" checkout --quiet main 2>/dev/null \
            || echo "[03-biglobster] Warning: checkout main failed for $ckdir (non-fatal)"
        HOME="$HERMES_HOME" as_hermes timeout 120 git -C "$target" pull --ff-only --quiet 2>&1 \
            || echo "[03-biglobster] Warning: git pull failed/timed out for $ckdir (non-fatal)"
    else
        echo "[03-biglobster] Cloning $BIGLOBSTER_SITE_REPO → $ckdir (depth 1)"
        HOME="$HERMES_HOME" as_hermes timeout 300 git clone --depth=1 \
            "https://github.com/$BIGLOBSTER_SITE_REPO.git" "$target" 2>&1 \
            || echo "[03-biglobster] Warning: git clone failed/timed out for $ckdir (non-fatal)"
    fi
    # Pin commit identity LOCALLY (per-checkout, beats the global .gitconfig) so
    # commits are always hermes@agent.local regardless of what a cron prompt or a
    # sibling job sets — this is what PASO 0 used to do per-run, now durable.
    if [ -d "$target/.git" ]; then
        HOME="$HERMES_HOME" as_hermes git -C "$target" config user.name "Hermes Agent" 2>/dev/null || true
        HOME="$HERMES_HOME" as_hermes git -C "$target" config user.email "hermes@agent.local" 2>/dev/null || true
    fi
done

# --- 6b-bis: strip embedded PATs from legacy top-level shared trees ----------
# Trees living DIRECTLY under $HERMES_HOME (e.g. /opt/data/biglobster — the
# SEO + Gap Hunter source tree the scheduler clones per-run) historically had a
# PAT baked into their origin URL:
#   https://x-access-token:TOKEN@github.com/owner/repo.git
# That plaintext token sits in .git/config AND was copied verbatim into every
# ephemeral per-run clone by cron/scheduler.py's _provision_isolated_checkout
# (the scheduler now strips it defensively too, but we fix the source of truth
# here). Sections 6/6b already keep the workspace + checkouts trees tokenless;
# this closes the one remaining class — top-level trees no other section owns.
# Auth stays ambient via the section-4 credential helper (global HOME=$HERMES_HOME
# store + ~/.git-credentials), so a tokenless remote still pushes. The loop only
# touches direct children of $HERMES_HOME that are git working trees with an
# http(s) origin carrying a "user:secret@" segment. Idempotent + non-fatal.
for top in "$HERMES_HOME"/*/; do
    [ -e "${top}.git" ] || continue
    cur=$(HOME="$HERMES_HOME" as_hermes git -C "$top" remote get-url origin 2>/dev/null) || continue
    case "$cur" in
        https://*@github.com/*|http://*@github.com/*)
            clean=$(printf '%s\n' "$cur" | sed -E 's#^(https?://)[^/@]*@#\1#')
            HOME="$HERMES_HOME" as_hermes git -C "$top" remote set-url origin "$clean" 2>/dev/null \
                && echo "[03-biglobster] Stripped token from remote: ${top%/}" \
                || echo "[03-biglobster] Warning: could not normalize remote for ${top%/} (non-fatal)"
            ;;
    esac
done

# --- 6c: install the managed git guard into every agent clone (every boot) ---
# Why: on 2026-06-22 a blind `git add -A && git commit` (commit dd0e1f5) captured
# the deletion of 48 cover/infographic images in br41s/biglobster while the
# HTML still referenced them — pushed straight to main, blog 404'd for ~22h.
# Root-cause class: blind `git add -A` in agent git flows + a shared mutable
# working tree where rebase/build state leaks in. This makes that class
# uncommittable in EVERY agent clone, not just biglobster.
#
# Mechanism: point each clone's core.hooksPath at the image-shipped guard. The
# managed pre-commit (1) blocks a commit deleting more than N tracked files
# (config-free, override HERMES_ALLOW_MASS_DELETION=1) and (2) chains to the
# repo's own .githooks/pre-commit for per-project broken-ref checks (biglobster's
# validate-assets.sh); the managed post-commit chains to the repo's post-commit
# (biglobster doc-sync). The managed pre-push blocks the agent git identities from
# pushing directly to `main` (override HERMES_ALLOW_PUSH_TO_MAIN=1), forcing every
# change through a branch + PR so the auditor gate can't be sidestepped; it chains
# to the repo's own .githooks/pre-push too. A blocked commit or push appends a
# signal to incidents/blocked-commits.jsonl, which the hourly incident watcher
# reports to the incidents Telegram thread.
#
# Single source of truth: $INSTALL_DIR/scripts/git-guard ships in the image and
# updates with every deploy — nothing is committed into the project repos, no
# per-repo copy to drift. The account is GitHub Free + private (no Actions /
# branch protection / pre-receive hooks), so this client-side install is the
# WHOLE enforcement path. Idempotent + non-fatal, like the rest of this script.
# Covers the per-profile workspace clones (section 6, incl. finview) and the
# isolated site checkouts (section 6b). The checkpoint shadow store lives under
# $HERMES_HOME/checkpoints — not under these roots — so it is untouched.
GIT_GUARD_DIR="$INSTALL_DIR/scripts/git-guard"
if [ -d "$GIT_GUARD_DIR" ]; then
    chmod +x "$GIT_GUARD_DIR"/pre-commit "$GIT_GUARD_DIR"/post-commit \
        "$GIT_GUARD_DIR"/pre-push "$GIT_GUARD_DIR"/check-mass-deletion.sh 2>/dev/null || true
    install_guard() {  # $1 = path to a git working tree
        [ -d "$1/.git" ] || return 0
        if HOME="$HERMES_HOME" as_hermes git -C "$1" config core.hooksPath "$GIT_GUARD_DIR" 2>/dev/null; then
            echo "[03-biglobster] git guard installed: $1"
        else
            echo "[03-biglobster] Warning: git guard install failed for $1 (non-fatal)"
        fi
    }
    for ws_repo in "$HERMES_HOME"/profiles/*/workspace/*/; do
        install_guard "${ws_repo%/}"
    done
    for ck in "$HERMES_HOME"/checkouts/*/; do
        install_guard "${ck%/}"
    done
else
    echo "[03-biglobster] Warning: git guard dir $GIT_GUARD_DIR missing — guard NOT installed"
fi

# --- 6d: auto-resync the auditor's prompt + SOUL from its pulled clone -------
# The auditor's behaviour lives in two volume-resident places that don't track
# the repo on their own: the cron job's prompt (jobs.json) and the live profile
# SOUL.md. Section 6 just pulled the auditor workspace clone to current main; here
# we propagate that into both, so an auditor change deploys by merge+restart with
# NO manual `hermes cron edit` / SOUL copy. (A hand-resync against a half-pulled
# clone caused a silent stale-prompt deploy on 2026-06-24 — this removes the step.)
# The auditor SOUL + prompt are now REPO-MANAGED: do not hand-edit the volume
# copies; they are overwritten from the clone every boot. Idempotent, non-fatal.
auditor_clone="$HERMES_HOME/profiles/auditor/workspace/hermes-sandbox"
auditor_soul="$HERMES_HOME/profiles/auditor/SOUL.md"
if [ -f "$auditor_clone/docker/profiles/auditor/SOUL.md" ] && [ -d "$HERMES_HOME/profiles/auditor" ]; then
    as_hermes cp "$auditor_clone/docker/profiles/auditor/SOUL.md" "$auditor_soul" \
        && echo "[03-biglobster] Resynced auditor SOUL.md from clone"
    # Section 5b appended the managed git-auth block to the PRE-pull SOUL; the
    # fresh copy lacks it, and 5b won't run again this boot — re-append here.
    if [ -f "$auditor_soul" ] && ! grep -q "Git Auth (managed" "$auditor_soul" 2>/dev/null; then
        printf '\n## Git Auth (managed — do not edit)\n- Auth is ambient: `git push` uses the stored credential helper and `gh` uses its on-disk config (`~/.config/gh/hosts.yml`). Both are provisioned for you.\n- NEVER write, edit, or recreate `.git-credentials` or `~/.config/gh/hosts.yml`, and NEVER put a token in a remote URL. The token you see is redacted to `***`, so writing it BLANKS the working credential and breaks all pushes.\n- NEVER switch a remote to SSH or generate SSH keys. Remotes stay tokenless `https://github.com/<owner>/<repo>.git`.\n- If a push or `gh` command fails auth, report it to the user verbatim — do not try to fix credentials yourself.\n' \
            | as_hermes tee -a "$auditor_soul" > /dev/null \
            && echo "[03-biglobster] Re-appended Git Auth block to auditor SOUL.md"
    fi
fi
# Prompt resync via the validated cron API (atomic save; no raw jobs.json edit).
# Prompt text comes from the freshly-pulled clone; the cron module is imported
# from the stable image source ($INSTALL_DIR) since it only does I/O on jobs.json.
if [ -f "$auditor_clone/auditor/auditor.prompt" ]; then
    PYTHONPATH="$INSTALL_DIR" HERMES_HOME="$HERMES_HOME" as_hermes "$PY" - "$auditor_clone/auditor/auditor.prompt" <<'PYEOF' || echo "[03-biglobster] Warning: auditor cron-prompt resync failed (non-fatal)"
import sys
from pathlib import Path
prompt = Path(sys.argv[1]).read_text(encoding="utf-8")
from cron.jobs import list_jobs, update_job
n = 0
for job in list_jobs(include_disabled=True):
    if job.get("profile") == "auditor" and job.get("prompt") != prompt:
        update_job(job["id"], {"prompt": prompt})
        n += 1
print(f"[03-biglobster] Resynced auditor cron prompt into {n} job(s)")
PYEOF
fi

# --- 6e: auditor GitHub webhook trigger (event-driven, replaces the poll) ---
# The auditor's own cron job used to fire every 10 minutes just to find out
# there was nothing to review — ~95% of those runs were a wasted LLM turn
# (python -m auditor.pending coming back empty). Root fix: let GitHub tell us
# when there's work, instead of asking on a timer.
#
# The webhook listener is enabled on the MAIN profile's gateway, never the
# auditor's: _GATEWAYLESS_PROFILES (hermes_cli/container_boot.py) forces the
# auditor profile's gateway hard-down unconditionally, because a second
# gateway seized the shared Telegram bot token and took down the default
# poller on 2026-06-24. The route uses trigger_cron_job_id (not a prompt) —
# it forces the auditor's REAL job due via the cron API directly, with ZERO
# agent/LLM turn involved. This is required, not just cheaper:
# _HERMES_WEBHOOK_SAFE_TOOLS (toolsets.py) intentionally excludes the
# terminal tool from every webhook-triggered agent session (webhook payloads
# can carry attacker-controlled content), so a prompt telling a model to run
# a shell command would have no tool able to execute it — found live
# 2026-07-03 when the first version of this route (agent-turn + fixed
# prompt) silently did nothing every time. The main profile's existing 60s
# in-process cron ticker (gateway/run.py) then executes the full, unchanged
# review/tiering/merge pipeline under the auditor's own profile context
# (creds, SOUL.md, tiers). No review logic, GitHub payload, or LLM reasoning
# ever touches this route.
#
# The auditor's own schedule is downgraded to a 6-hourly safety net here too,
# so a missed/failed webhook delivery still self-heals same-day.
#
# Idempotent + non-fatal, matching the rest of this script. Requires
# HERMES_AUDITOR_WEBHOOK_SECRET (HMAC secret shared with every GitHub webhook
# registered against /webhooks/auditor-pr-trigger — registering the webhook
# on each covered repo is a one-time `gh api repos/<owner>/<repo>/hooks` step
# done from the CLI, not by this script).
WEBHOOK_SECRET="${HERMES_AUDITOR_WEBHOOK_SECRET:-}"
if [ -z "$WEBHOOK_SECRET" ] && [ -f "$HERMES_HOME/.env" ]; then
    WEBHOOK_SECRET=$(grep -E '^HERMES_AUDITOR_WEBHOOK_SECRET=' "$HERMES_HOME/.env" 2>/dev/null \
        | tail -n1 | cut -d= -f2- | tr -d '\r')
fi
if [ -n "$WEBHOOK_SECRET" ]; then
    PYTHONPATH="$INSTALL_DIR" HERMES_HOME="$HERMES_HOME" WEBHOOK_SECRET="$WEBHOOK_SECRET" \
        as_hermes "$PY" - <<'PYEOF' || echo "[03-biglobster] Warning: auditor webhook reconcile failed (non-fatal)"
import os
import yaml
from pathlib import Path
from cron.jobs import list_jobs, update_job

home = Path(os.environ.get("HERMES_HOME", "/opt/data"))
secret = os.environ["WEBHOOK_SECRET"]

# Downgrade the auditor's own poll to a 6h safety net (was every 10 min).
auditor_job_id = None
for job in list_jobs(include_disabled=True):
    if job.get("profile") == "auditor":
        auditor_job_id = job["id"]
        # parse_schedule("every 6 hours") normalizes to {"kind": "interval",
        # "minutes": 360, "display": "every 360m"} — compare on minutes, not
        # the display string, so this stays idempotent across boots.
        sched = job.get("schedule") or {}
        if sched.get("kind") != "interval" or sched.get("minutes") != 360:
            update_job(job["id"], {"schedule": "every 6 hours"})
            print(f"[03-biglobster] Auditor job {job['id']}: schedule -> every 6 hours")
        break

if auditor_job_id is None:
    print("[03-biglobster] Warning: no cron job with profile=auditor found — webhook route not wired")
else:
    config_path = home / "config.yaml"
    if not config_path.exists():
        print("[03-biglobster] main: config.yaml not present yet — webhook route not wired")
    else:
        cfg = yaml.safe_load(config_path.read_text()) or {}
        changed = False

        platforms = cfg.get("platforms")
        if not isinstance(platforms, dict):
            platforms = {}
            cfg["platforms"] = platforms
        webhook = platforms.get("webhook")
        if not isinstance(webhook, dict):
            webhook = {}
            platforms["webhook"] = webhook
        if webhook.get("enabled") is not True:
            webhook["enabled"] = True
            changed = True
        extra = webhook.get("extra")
        if not isinstance(extra, dict):
            extra = {}
            webhook["extra"] = extra
        if extra.get("port") != 8644:
            extra["port"] = 8644
            changed = True
        routes = extra.get("routes")
        if not isinstance(routes, dict):
            routes = {}
            extra["routes"] = routes

        route = {
            "secret": secret,
            "events": ["pull_request"],
            "trigger_cron_job_id": auditor_job_id,
        }
        if routes.get("auditor-pr-trigger") != route:
            routes["auditor-pr-trigger"] = route
            changed = True

        if changed:
            config_path.write_text(yaml.dump(cfg, default_flow_style=False))
            print("[03-biglobster] main: reconciled platforms.webhook (auditor-pr-trigger)")
        else:
            print("[03-biglobster] main: platforms.webhook already current")
PYEOF
else
    echo "[03-biglobster] HERMES_AUDITOR_WEBHOOK_SECRET not set — auditor webhook route not wired"
fi

# --- 7: egress diagnostics (non-fatal) ---
echo "[03-biglobster] Egress openrouter.ai: $(curl -sf --max-time 5 -o /dev/null -w '%{http_code}' https://openrouter.ai/ 2>/dev/null || echo FAIL)"
# Probe the real router endpoint (/v1/models returns 200 without auth); the
# bare root 404s by design, which made the old check a false negative.
echo "[03-biglobster] Egress router.huggingface.co: $(curl -sf --max-time 5 -o /dev/null -w '%{http_code}' https://router.huggingface.co/v1/models 2>/dev/null || echo FAIL)"

exit 0
