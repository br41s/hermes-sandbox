# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# allow assistant-ui packages & a couple specific deps since they update a LOT.
# remove this when we stabilize (or we haven't updated in 2 wks)
min-release-age-exclude[]=@assistant-ui/*
min-release-age-exclude[]=assistant-cloud
min-release-age-exclude[]=assistant-stream
min-release-age-exclude[]=@radix-ui/*
min-release-age-exclude[]=radix-ui
min-release-age-exclude[]=safe-content-frame

# react-router 8.3.0 includes fixes for vulns. remove this when 8.3.0 is > 2wks old.
min-release-age-exclude[]=react-router

# eslint 10.8.0 includes fixes for vulns. remove this when 10.8.0 is > 2wks old.
min-release-age-exclude[]=eslint
min-release-age-exclude[]=@eslint/*

# tar 7.5.21 includes fixes for vulns. remove this when 7.5.21 is > 2wks  old
min-release-age-exclude[]=tar

# concurrently 10.0.4 includes fixes for vulns. remove this when 10.0.4 is > 2wks  old
min-release-age-exclude[]=concurrently

# minimatch 10.2.6 includes fixes for vulns. remove this when 10.2.6 is > 2wks  old
min-release-age-exclude[]=minimatch


# mermaid 11.16.1 includes fixes for 5 GHSAs. remove when > 2wks old (rel 2026-08-04)
min-release-age-exclude[]=mermaid

# dompurify 3.4.17 fixes GHSA-55q2-fjhq-7xh7 follow-ups (low). remove when 3.4.17 is > 2wks old (rel 2026-10-12)
min-release-age-exclude[]=dompurify

# ink needs
min-release-age-exclude[]=lightningcss
min-release-age-exclude[]=postcss

# source-map-js 1.2.2 fixes GHSA-68fv-2mgg-jv7q (high, event-loop DoS). remove when 1.2.2 is > 2wks old (rel 2026-09-30)
min-release-age-exclude[]=source-map-js

# http-cache-semantics 4.3.0 fixes GHSA-ch52-4w7c-c8xp (high, cross-user cached data disclosure).
# remove when 4.3.0 is > 2wks old (rel 2026-10-04)
min-release-age-exclude[]=http-cache-semantics

# ip-address 10.7.4 fixes GHSA-8xj3-p8x2-m3c7-family alerts (medium). remove when 10.7.4 is > 2wks old (rel 2026-10-11)
min-release-age-exclude[]=ip-address

# sanitize-html 2.18.1 fixes GHSA-c9rx-x947-fp3h (medium), introduced by 2.18.0 which fixes
# GHSA-x3q4-9hxx-gx8m/GHSA-cv27-6wvh-8x7j/GHSA-374f-7chj-9948. remove when 2.18.1 is > 2wks old (rel 2026-10-14)
min-release-age-exclude[]=sanitize-html

# vitest 4.1.12 is a patch bump (4.1.11 -> 4.1.12). remove when 4.1.12 is > 2wks old (rel 2026-10-15)
min-release-age-exclude[]=vitest
min-release-age-exclude[]=@vitest/*


# electron 44.9.3 backports upstream Chromium/V8 security fixes, and 44.9.1+ carries the
# eMudhra root distrust per #142533. remove when 44.9.3 is > 2wks old (rel 2026-10-21)
min-release-age-exclude[]=electron
